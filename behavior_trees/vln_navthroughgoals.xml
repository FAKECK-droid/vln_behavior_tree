
<!--
  This Behavior Tree replans the global path periodically at 1 Hz through an array of poses continuously
   and it also has recovery actions specific to planning / control as well as general system issues.
-->
<root main_tree_to_execute="VlnNavThroughGoals">
  <BehaviorTree ID="VlnNavThroughGoals">
    <Sequence name="NavigationWithEvents">
      <ForceSuccess>
        <NavigationEvent name="ReportGoalsNavigationStarted" event="navigation_started" message="开始导航。"/>
      </ForceSuccess>
      <Fallback name="NavigationResult">
        <Sequence name="NavigateAndReportCompletion">
          <RecoveryNode number_of_retries="6" name="NavigateRecovery">
            <PipelineSequence name="NavigateWithReplanning">
              <RateController hz="0.333">
                <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
                  <ReactiveSequence>
                    <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7"/>
                    <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
                  </ReactiveSequence>
                  <Sequence name="PlanningRecoveryWithEvent">
                    <ForceSuccess>
                      <NavigationEvent name="ReportGoalsPlanningRecovery" event="navigation_recovery" message="路径规划失败，开始清理全局代价地图。"/>
                    </ForceSuccess>
                    <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
                  </Sequence>
                </RecoveryNode>
              </RateController>
              <RecoveryNode number_of_retries="1" name="FollowPath">
                <FollowPath path="{path}" controller_id="FollowPath"/>
                <Sequence name="ControlRecoveryWithEvent">
                  <ForceSuccess>
                    <NavigationEvent name="ReportGoalsControlRecovery" event="navigation_recovery" message="路径跟踪失败，开始清理局部代价地图。"/>
                  </ForceSuccess>
                  <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
                </Sequence>
              </RecoveryNode>
            </PipelineSequence>
            <ReactiveFallback name="RecoveryFallback">
              <GoalUpdated/>
              <Sequence name="SystemRecoveryWithEvent">
                <ForceSuccess>
                  <NavigationEvent name="ReportGoalsSystemRecovery" event="navigation_recovery" message="开始执行系统恢复动作。"/>
                </ForceSuccess>
                <RoundRobin name="RecoveryActions">
                  <Sequence name="ClearingActions">
                    <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
                    <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
                  </Sequence>
                  <Spin spin_dist="1.57"/>
                  <Wait wait_duration="5"/>
                  <BackUp backup_dist="0.30" backup_speed="0.05"/>
                </RoundRobin>
              </Sequence>
            </ReactiveFallback>
          </RecoveryNode>
          <ForceSuccess>
            <NavigationEvent name="ReportGoalsNavigationCompleted" event="navigation_completed" message="已到达导航目标。"/>
          </ForceSuccess>
        </Sequence>
        <Sequence name="ReportFinalNavigationFailure">
          <ForceSuccess>
            <NavigationEvent name="ReportGoalsNavigationFailed" event="navigation_failed" message="导航最终失败。"/>
          </ForceSuccess>
          <AlwaysFailure/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>
</root>
