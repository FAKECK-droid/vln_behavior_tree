
<!--
  Plan once per waypoint attempt and follow the path until completion or recovery.
  Intermediate arrival uses position only; the final leg also uses the controller goal checker.
-->
<root main_tree_to_execute="VlnNavThroughGoals">
  <BehaviorTree ID="VlnNavThroughGoals">
    <Sequence name="NavigationWithEvents">
      <ForceSuccess>
        <NavigationEvent name="ReportGoalsNavigationStarted" event="navigation_started" message="开始导航。"/>
      </ForceSuccess>
      <Fallback name="NavigationResult">
        <Sequence name="NavigateAndReportCompletion">
          <FollowWaypoints goals="{goals}" waypoint="{waypoint}" is_final="{is_final}"
                           route_revision="{route_revision}" path="{path}">
            <RecoveryNode number_of_retries="1" name="NavigateRecovery">
              <ReactiveFallback name="CompleteOrFollowWaypoint">
                <WaypointPositionReached waypoint="{waypoint}" is_final="{is_final}" xy_tolerance="0.50"/>
                <Sequence name="FollowAndConfirmWaypoint">
                  <RecoveryNode number_of_retries="5" name="ComputeWaypointPath">
                    <Sequence>
                      <ComputePathToPose goal="{waypoint}" path="{candidate_path}" planner_id="GridBased"/>
                      <ValidateWaypointPath waypoint="{waypoint}" candidate_path="{candidate_path}"
                                            xy_tolerance="0.50" path="{path}"/>
                    </Sequence>
                    <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
                  </RecoveryNode>
                  <RecoveryNode number_of_retries="5" name="FollowPath">
                    <ReportNearWaypoint waypoint="{waypoint}" is_final="{is_final}"
                                        route_revision="{route_revision}" distance_m="2.0">
                      <FollowPath path="{path}" controller_id="FollowPath"/>
                      <Sequence name="ReportFinalWaypointSurroundings">
                        <GetSurroundings costmap="global" range_m="12.0" output="{surroundings}"/>
                        <SubmitSurroundings name="ReportSurroundingsNearFinalWaypoint" input="{surroundings}"/>
                      </Sequence>
                    </ReportNearWaypoint>
                    <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
                  </RecoveryNode>
                  <WaypointPositionReached waypoint="{waypoint}" xy_tolerance="0.50"/>
                </Sequence>
              </ReactiveFallback>
              <Sequence name="SystemRecoveryWithEvent">
                <ForceSuccess>
                  <NavigationEvent name="ReportGoalsSystemRecovery" event="navigation_recovery" message="开始执行系统恢复动作。"/>
                </ForceSuccess>
                <RoundRobin name="RecoveryActions">
                  <Sequence name="ClearingActions">
                    <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
                    <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
                  </Sequence>
                  <Spin spin_dist="1.57"/>
                  <Wait wait_duration="5"/>
                  <BackUp backup_dist="0.30" backup_speed="0.05"/>
                </RoundRobin>
              </Sequence>
            </RecoveryNode>
          </FollowWaypoints>
          <ForceSuccess>
            <NavigationEvent name="ReportGoalsNavigationCompleted" event="navigation_completed" message="已到达导航目标。"/>
          </ForceSuccess>
        </Sequence>
        <Sequence name="ReportFinalNavigationFailure">
          <ForceSuccess>
            <NavigationEvent name="ReportGoalsNavigationFailed" event="navigation_failed" message="导航最终失败。"/>
          </ForceSuccess>
          <AlwaysFailure/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>
</root>
